{
  "name": "QuickWeather",
  "short_name": "QuickWeather",
  "description": "A swipe-first weather PWA with saved cities and quick forecast views.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#142033",
  "theme_color": "#142033",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
